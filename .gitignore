# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Full-size photo originals: keep them locally, but only the web-sized copies in
# public/media/ are published. (Make copies with scripts/optimize_photos.py.)
/public/images/2022*/
/public/images/2023MIT/
/public/images/2024*/
/public/images/2025BU/
/public/images/2026EJI/

